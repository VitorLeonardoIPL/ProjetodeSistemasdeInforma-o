<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuração do servidor da API (requisito do enunciado de AMSI:
    "menu de configuração que possibilite a inserção dos dados do servidor").
    Aberto pelo ícone de definições no Login e pela linha "Servidor da API" no Perfil.
    O endereço é guardado em SharedPreferences.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/fg_surface"
    tools:context=".ui.comum.ConfiguracaoActivity">

    <include
        android:id="@+id/top_bar"
        layout="@layout/layout_top_bar_back"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/ll_rodape"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/fg_screen_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cfg_intro"
                android:textAppearance="@style/TextAppearance.FrotaGest.Muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fg_gap_l"
                android:layout_marginBottom="6dp"
                android:labelFor="@id/et_url"
                android:text="@string/cfg_url"
                android:textAppearance="@style/TextAppearance.FrotaGest.FieldLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="clear_text"
                app:helperText="@string/cfg_url_ajuda"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cfg_url_hint"
                    android:inputType="textUri"
                    android:minHeight="@dimen/fg_button_height" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_testar"
                style="@style/Widget.FrotaGest.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fg_gap_l"
                android:text="@string/cfg_testar" />

            <!-- Resultado do teste: Status.Disponivel (OK) ou Status.Recusada (falhou) -->
            <TextView
                android:id="@+id/tv_resultado"
                style="@style/Widget.FrotaGest.Status.Disponivel"
                android:layout_marginTop="@dimen/fg_gap_m"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone"
                android:text="Ligação estabelecida (180 ms)"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_repor"
                style="@style/Widget.FrotaGest.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fg_gap_s"
                android:paddingStart="0dp"
                android:text="@string/cfg_repor"
                android:textStyle="normal" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/ll_rodape"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/fg_screen_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_guardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_guardar" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
