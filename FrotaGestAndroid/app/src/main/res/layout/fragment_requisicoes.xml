<?xml version="1.0" encoding="utf-8"?>
<!-- M-Requisicoes · Colaborador · separador "Pedidos" · "Novo pedido" só no botão flutuante -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fg_background"
    tools:context=".ui.colaborador.RequisicoesFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/top_bar"
            layout="@layout/layout_top_bar" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_filtro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/fg_screen_padding"
                android:paddingTop="@dimen/fg_gap_m"
                android:paddingEnd="@dimen/fg_screen_padding"
                app:checkedChip="@id/chip_ativas"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_ativas"
                    style="@style/Widget.FrotaGest.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/req_filtro_ativas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_pendentes"
                    style="@style/Widget.FrotaGest.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/req_filtro_pendentes" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_historico"
                    style="@style/Widget.FrotaGest.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/req_filtro_historico" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Lista preenchida por um adaptador (BaseAdapter) com item_requisicao -->
            <ListView
                android:id="@+id/lv_requisicoes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="@dimen/fg_gap_m"
                android:paddingStart="@dimen/fg_screen_padding"
                android:paddingTop="@dimen/fg_gap_m"
                android:paddingEnd="@dimen/fg_screen_padding"
                android:paddingBottom="96dp"
                android:scrollbarStyle="outsideOverlay"
                tools:listitem="@layout/item_requisicao" />

            <TextView
                android:id="@+id/tv_vazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="@dimen/fg_screen_padding_large"
                android:text="@string/sem_resultados"
                android:textAppearance="@style/TextAppearance.FrotaGest.Muted"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_novo_pedido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fg_screen_padding"
        android:text="@string/req_novo_pedido"
        android:textAllCaps="false"
        android:textColor="@color/fg_surface"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/fg_primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/fg_surface"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.FrotaGest.Pill" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
