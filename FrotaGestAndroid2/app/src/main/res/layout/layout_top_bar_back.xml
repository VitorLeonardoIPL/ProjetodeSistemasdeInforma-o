<?xml version="1.0" encoding="utf-8"?>
<!--
    Cabeçalho dos ecrãs de detalhe (sem barra inferior):
    seta de voltar, título, subtítulo opcional e, à direita,
    uma etiqueta de estado OU uma ação de texto (ex.: "Marcar lidas").
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_top_bar"
    android:minHeight="@dimen/fg_top_bar_height"
    android:paddingStart="4dp"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/fg_screen_padding"
    android:paddingBottom="10dp">

    <ImageButton
        android:id="@+id/btn_voltar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_voltar"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/fg_primary" />

    <TextView
        android:id="@+id/tv_top_bar_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fg_gap_s"
        android:layout_marginEnd="@dimen/fg_gap_s"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.FrotaGest.ScreenTitle"
        app:layout_constraintBottom_toTopOf="@id/tv_top_bar_subtitle"
        app:layout_constraintEnd_toStartOf="@id/fl_top_bar_end"
        app:layout_constraintStart_toEndOf="@id/btn_voltar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="@string/not_titulo" />

    <TextView
        android:id="@+id/tv_top_bar_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.FrotaGest.ScreenSubtitle"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tv_top_bar_title"
        app:layout_constraintStart_toStartOf="@id/tv_top_bar_title"
        app:layout_constraintTop_toBottomOf="@id/tv_top_bar_title"
        tools:text="3 por ler"
        tools:visibility="visible" />

    <!-- Zona direita: etiqueta de estado ou ação de texto -->
    <FrameLayout
        android:id="@+id/fl_top_bar_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_top_bar_status"
            style="@style/Widget.FrotaGest.Status.Pendente"
            android:layout_gravity="center_vertical"
            android:visibility="gone"
            tools:text="@string/estado_pendente" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_top_bar_acao"
            style="@style/Widget.FrotaGest.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="0dp"
            android:visibility="gone"
            tools:text="@string/not_marcar_lidas"
            tools:visibility="visible" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
