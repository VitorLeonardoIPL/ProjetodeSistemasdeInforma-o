<?xml version="1.0" encoding="utf-8"?>
<!-- Espaço vazio para fotografia (contorno tracejado) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/fg_primary_tint" />
    <stroke
        android:width="1.5dp"
        android:color="@color/fg_primary"
        android:dashWidth="5dp"
        android:dashGap="3dp" />
    <corners android:radius="8dp" />
</shape>
