<?xml version="1.0" encoding="utf-8"?>
<!--
    Cabeçalho dos ecrãs principais (com barra inferior):
    título, subtítulo opcional, etiqueta de estado opcional e sino de notificações
    no canto superior direito com contador de não lidas.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_top_bar"
    android:minHeight="@dimen/fg_top_bar_height"
    android:paddingStart="@dimen/fg_screen_padding"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/fg_screen_padding"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tv_top_bar_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/fg_gap_m"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.FrotaGest.ScreenTitle"
        app:layout_constraintBottom_toTopOf="@id/ll_top_bar_subtitle"
        app:layout_constraintEnd_toStartOf="@id/fl_notificacoes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="@string/req_titulo" />

    <LinearLayout
        android:id="@+id/ll_top_bar_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tv_top_bar_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_top_bar_title"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_top_bar_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.FrotaGest.ScreenSubtitle"
            tools:text="Coordenador de Frota · Rui Matos" />

        <TextView
            android:id="@+id/tv_top_bar_status"
            style="@style/Widget.FrotaGest.Status.Aprovada"
            android:layout_marginStart="@dimen/fg_gap_s"
            android:visibility="gone"
            tools:text="@string/estado_em_curso" />
    </LinearLayout>

    <!-- Sino de notificações + contador -->
    <FrameLayout
        android:id="@+id/fl_notificacoes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_notificacoes"
            android:layout_width="@dimen/fg_bell_size"
            android:layout_height="@dimen/fg_bell_size"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_bell_button"
            android:contentDescription="@string/cd_notificacoes"
            android:src="@drawable/ic_bell"
            app:tint="@color/fg_ink" />

        <TextView
            android:id="@+id/tv_badge_notificacoes"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_notification_badge"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:minWidth="20dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:textColor="@color/fg_surface"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="2"
            tools:visibility="visible" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
